# Copy to .env and fill in. NEVER commit .env — see .gitignore
# The demo needs NONE of these: Rscript scripts/run_demo.R

# ---- Bank host-to-host API ----
BANK_API_BASE=
BANK_API_KEY=
BANK_API_SECRET=

# ---- ERP invoicing API ----
ERP_API_BASE=
ERP_API_TOKEN=

# ---- Snowflake (key-pair auth, no password) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_ANALYTICS
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_JDBC_JAR=

# ---- Unattended job ----
SYNC_LOG_PATH=./logs/sync.log
